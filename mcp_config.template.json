{
  "mcpServers": {
    "godot": {
      "command": "npx",
      "args": ["-y", "@n24q02m/better-godot-mcp"],
      "env": {
        "GODOT_PATH": "REPLACE_WITH_GODOT_EXECUTABLE_PATH",
        "GODOT_PROJECT_PATH": "REPLACE_WITH_THIS_PROJECT_FOLDER"
      }
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "REPLACE_WITH_THIS_PROJECT_FOLDER/.agents/memory.jsonl"
      }
    }
  }
}
